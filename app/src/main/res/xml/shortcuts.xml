<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.PLAY_AUDIO">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.music.echo"
            android:targetClass="com.music.echo.MainActivity" />
    </capability>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.music.echo.action.SEARCH"
            android:targetClass="com.music.echo.MainActivity"
            android:targetPackage="com.music.echo" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_library"
        android:shortcutId="library"
        android:shortcutShortLabel="@string/filter_library">
        <intent
            android:action="com.music.echo.action.LIBRARY"
            android:targetClass="com.music.echo.MainActivity"
            android:targetPackage="com.music.echo" />
    </shortcut>
</shortcuts>
