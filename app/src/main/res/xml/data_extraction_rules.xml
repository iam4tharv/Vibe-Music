<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vibemusic_auth.xml" />
        <exclude domain="sharedpref" path="vibemusic_auth_plain.xml" />
        <exclude domain="sharedpref" path="vibemusic_sources.xml" />
        <exclude domain="sharedpref" path="vibemusic_sources_plain.xml" />
        <exclude domain="no_backup" path="vibe_install_launch_state.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vibemusic_auth.xml" />
        <exclude domain="sharedpref" path="vibemusic_auth_plain.xml" />
        <exclude domain="sharedpref" path="vibemusic_sources.xml" />
        <exclude domain="sharedpref" path="vibemusic_sources_plain.xml" />
        <exclude domain="no_backup" path="vibe_install_launch_state.json" />
    </device-transfer>
</data-extraction-rules>
